# Shape of the generated .env.production. DO NOT fill this in and commit it —
# the real file is written by deploy.sh from SSM Parameter Store
# (/copper-cloves/prod, region ap-south-1) and is gitignored.
#
# Seed a parameter with:
#   aws ssm put-parameter --region ap-south-1 --type SecureString --overwrite \
#     --name /copper-cloves/prod/NEXTAUTH_SECRET --value '...'
# The deploy script strips the path prefix, so the parameter's last path segment
# IS the env var name.

# --- ingress -----------------------------------------------------------------
APP_DOMAIN=thestudiobycopperandcloves.in
ACME_EMAIL=ops@example.com

# --- database ----------------------------------------------------------------
# The app connects through the pooler on the private compose network. No sslmode:
# pgbouncer terminates TLS to RDS itself, and src/lib/prisma.ts only forces TLS
# for hosts matching rds.amazonaws.com.
STUDIO_DATABASE_URL=postgresql://postgres:PASSWORD@pgbouncer:6432/postgres

# Direct RDS connection, used ONLY by the one-shot `migrate` service. `prisma db
# push` needs a real session for its advisory lock and DDL.
DIRECT_DATABASE_URL=postgresql://postgres:PASSWORD@copper-cloves.c52g80yysrkp.ap-south-1.rds.amazonaws.com:5432/postgres?sslmode=require

# pgbouncer's own upstream credentials (it dials RDS with these).
PGBOUNCER_DB_HOST=copper-cloves.c52g80yysrkp.ap-south-1.rds.amazonaws.com
PGBOUNCER_DB_PORT=5432
PGBOUNCER_DB_USER=postgres
PGBOUNCER_DB_PASSWORD=PASSWORD
PGBOUNCER_DB_NAME=postgres

# --- auth --------------------------------------------------------------------
NEXTAUTH_URL=https://thestudiobycopperandcloves.in
NEXTAUTH_SECRET=

# --- payments ----------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- email / notifications ---------------------------------------------------
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
RESEND_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- storage -----------------------------------------------------------------
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- ops ---------------------------------------------------------------------
# Used by the in-box cron container's x-cron-secret header.
CRON_SECRET=
AWS_REGION=ap-south-1
