# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
.env.production
.env.development

# Logs and local uploads (use object storage / .env.example in production)
/logs/
/uploads/

# vercel
.vercel

# mobile-revamp visual audit scratch (screenshots only, never committed)
/.audit/

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase
firebase-service-account.json

# local dev: user uploads fallback when S3 not configured. We keep files locally
# but never commit — production uploads go to S3.
/public/uploads/

# originals backed up by scripts/optimize-images.ts before in-place re-encode.
/public/_originals/

# IDE / agent tooling (local only)
/.idea/
/.vscode/
/.claude/
/.agents/
/.cursor/
/.llm/
/.softgen/
/.superpowers/
/.impeccable/
/skills-lock.json

# One-off ops / backfill scripts (keep reusable scripts in repo)
/scripts/backfill-*.ts
/scripts/inspect-*.ts
/scripts/onboard-missing-*.ts
/scripts/_*.ts
/scripts/migrate-images-*.ts
/scripts/test-s3.ts
/graphify-out
/docs
.superpowers/

# local agent/context dirs (not shipped)
.impeccable/
.remember/
.llm/
docs/
