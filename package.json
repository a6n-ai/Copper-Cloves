    "scheduler": "tsx scripts/scheduler.ts",
    "test:payout": "tsx scripts/test-payoutCalc.ts",
    "test:auth": "LOG_LEVEL=silent tsx scripts/test-auth-password.ts && LOG_LEVEL=silent tsx scripts/test-auth-roles.ts",
