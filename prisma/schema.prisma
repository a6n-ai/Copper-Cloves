// Rust-free client engine + @prisma/adapter-pg — avoids Amplify/Lambda "query engine not found" deploy errors.
generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id             String   @id @default(uuid())
  email          String
  full_name      String?
  phone          String?
  whatsapp_phone String?
  avatar_url     String?
  avatar_file_id String?  @unique
  movement_streak      Int      @default(0)
  pass_type            String?
  hashedPassword       String?
  role                 String   @default("user")
  dob                  DateTime?
  gender               String?
  onboarding_completed Boolean  @default(false)
  questionnaire        Json?
  terms_accepted_at    DateTime?
  start_date           DateTime?
  created_at           DateTime @default(now())
  updated_at           DateTime @default(now()) @updatedAt

  instructor_account Instructor?
  partner_memberships PartnerMember[]
  bookings          Booking[]
  cafe_orders       CafeOrder[]
  meal_subscriptions MealSubscription[]
  user_badges       UserBadge[]
  user_packages     UserPackage[]
  user_stats        UserStats?
  user_streaks      UserStreak?
  waivers           Waiver[]
  crm_messages      CrmMessage[]
  activity_sessions UserActivitySession[]
  activity_events   UserActivityEvent[]
  retail_orders     RetailOrder[]
  coupon_redemptions CouponRedemption[]
  razorpay_orders   RazorpayOrder[]
  member_tickets    MemberTicket[]
  payments          Payment[]
  recorded_payments Payment[] @relation("PaymentRecordedBy")
  session           UserSession?

  @@unique([email, role])
  @@map("profiles")
}

/// Single active login session per profile (anti session-sharing). The
/// `session_id` is embedded as `sid` in the JWT; a fresh login upserts this row
/// so any older token (another device, or a copied cookie) fails validation —
/// "kick the old device". `fingerprint` (User-Agent hash) binds the token to the
/// browser it was issued to; `last_seen_at` powers the idle timeout. Enforced
/// centrally in getStudioServerSession via isRequestSessionValid.
model UserSession {
  id           String   @id @default(cuid())
  profile_id   String   @unique
  session_id   String
  fingerprint  String
  ip           String?
  user_agent   String?
  created_at   DateTime @default(now())
  last_seen_at DateTime @default(now())
  profile      Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@map("user_sessions")
}

/// Promotional codes: food (café), ecommerce (boutique), class_pass, or studio_pass.
model Coupon {
  id                String    @id @default(uuid())
  code              String    @unique
  applies_to        String
  discount_type     String
  discount_value    Decimal   @db.Decimal(10, 2)
  is_active         Boolean   @default(true)
  max_redemptions   Int?
  redemption_count  Int       @default(0)
  max_uses_per_user Int?
  starts_at         DateTime?
  ends_at           DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now()) @updatedAt

  redemptions   CouponRedemption[]
  cafe_orders   CafeOrder[]
  retail_orders RetailOrder[]
  user_packages UserPackage[]

  @@map("coupons")
}

model CouponRedemption {
  id              String   @id @default(uuid())
  coupon_id       String
  user_id         String?
  guest_email     String?
  context         String
  discount_amount Decimal  @db.Decimal(10, 2)
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt

  coupon  Coupon   @relation(fields: [coupon_id], references: [id], onDelete: Cascade)
  profile Profile? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([coupon_id])
  @@index([user_id])
  @@index([guest_email])
  @@map("coupon_redemptions")
}

model RetailProduct {
  id          String   @id @default(uuid())
  name        String
  category    String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  image_url   String?
  image_file_id String? @unique
  featured    Boolean  @default(false)
  sales_count Int      @default(0)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  @@map("retail_products")
}

model RetailOrder {
  id               String   @id @default(uuid())
  user_id          String?
  customer_name    String
  customer_email   String
  items            Json
  total            Decimal  @db.Decimal(12, 2)
  status           String   @default("pending")
  payment_method   String   @default("studio")
  shipping_address String?
  order_date       DateTime @default(now())
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt
  coupon_id        String?
  discount_inr     Decimal  @default(0) @db.Decimal(10, 2)

  profile Profile? @relation(fields: [user_id], references: [id], onDelete: SetNull)
  coupon  Coupon?  @relation(fields: [coupon_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([coupon_id])
  @@index([order_date])
  @@map("retail_orders")
}

model Instructor {
  id                 String   @id @default(uuid())
  name               String
  title              String?
  email              String?
  phone              String?
  /// Percent of class check-in revenue retained by the studio (0–100). Instructor share = 100 − this. Not public.
  studio_payout_cut_percent Decimal? @db.Decimal(5, 2)
  image_url          String?
  image_file_id      String?  @unique
  about              String?
  philosophy         String?
  specialties        String[]
  certifications     String[]
  years_of_experience String?
  display_order      Int?
  social_facebook    String?
  social_twitter     String?
  social_linkedin    String?
  social_whatsapp    String?
  hashed_password          String?
  is_active                Boolean  @default(true)
  /// Links this instructor to their unified-login user account (NextAuth Profile).
  profile_id               String?  @unique
  created_at               DateTime @default(now())
  updated_at               DateTime @default(now()) @updatedAt

  classes                    ClassModel[]
  class_schedules            ClassSchedule[] @relation("ScheduledInstructor")
  actual_class_schedules     ClassSchedule[] @relation("ActualInstructor")
  profile                    Profile? @relation(fields: [profile_id], references: [id], onDelete: SetNull)

  @@map("instructors")
}

model ClassModel {
  id            String   @id @default(uuid())
  name          String
  category      String
  description   String?
  benefits      String[]
  duration      Int
  max_capacity  Int      @default(15)
  image_url     String?
  image_file_id String?  @unique
  display_order Int?
  instructor_id String?
  /// When set, this class is run by an external partner/brand (rented slot) — its bookings need partner sign-off.
  partner_id    String?
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  instructor      Instructor?     @relation(fields: [instructor_id], references: [id], onDelete: SetNull)
  partner         Partner?        @relation(fields: [partner_id], references: [id], onDelete: SetNull)
  class_schedules ClassSchedule[]

  @@index([instructor_id])
  @@index([partner_id])
  @@map("class_types")
}

/// External partner/brand renting the studio to run their own classes (e.g. Physique 57). Mainly classes today; rentals/events can attach later.
model Partner {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  logo_url      String?
  description   String?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  classes ClassModel[]
  members PartnerMember[]

  @@map("partners")
}

/// Links a user (Profile) to a Partner they manage — a partner can have many users,
/// and a user could belong to multiple partners. `role`: manager today, instructor later.
model PartnerMember {
  id         String   @id @default(uuid())
  partner_id String
  profile_id String
  role       String   @default("manager")
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  partner Partner @relation(fields: [partner_id], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([partner_id, profile_id])
  @@index([profile_id])
  @@map("partner_members")
}

model ClassSchedule {
  id               String   @id @default(uuid())
  class_id         String
  /// Planned instructor at time of scheduling.
  instructor_id    String?
  /// Who actually taught — set post-class if a sub covered. Null = planned instructor taught.
  actual_instructor_id      String?
  start_time       DateTime
  end_time         DateTime
  capacity         Int?
  available_spots  Int
  current_bookings Int      @default(0)
  status                    ClassScheduleStatus @default(available)
  instructor_check_in_time  DateTime?
  /// `on_time` | `late` | `absent` — set after class ends.
  instructor_check_in_outcome String?
  /// Admin notes for this session (sub reason, incidents, announcements).
  class_notes               String?
  /// Set when the ~6h pre-class instructor roster email has been sent (idempotency guard).
  roster_sent_at            DateTime?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @default(now()) @updatedAt

  class_model       ClassModel?  @relation(fields: [class_id], references: [id], onDelete: Cascade)
  instructor        Instructor?  @relation("ScheduledInstructor", fields: [instructor_id], references: [id], onDelete: SetNull)
  actual_instructor Instructor?  @relation("ActualInstructor", fields: [actual_instructor_id], references: [id], onDelete: SetNull)
  bookings          Booking[]
  qr_codes          QrCode[]

  @@index([class_id])
  @@index([instructor_id])
  @@index([actual_instructor_id])
  @@index([start_time])
  /// Prevent duplicate schedules at the same slot for the same class+instructor.
  @@unique([start_time, class_id, instructor_id], name: "class_schedules_slot_unique")
  @@map("class_schedules")
}

model PackageType {
  id                  String   @id @default(uuid())
  name                String
  type                String
  class_count         Int?
  duration_months     Int?
  price               Decimal  @db.Decimal(10, 2)
  includes_physique_57 Boolean @default(false)
  is_unlimited        Boolean  @default(false)
  description         String?
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now()) @updatedAt

  user_packages UserPackage[]

  @@map("package_types")
}

model Package {
  id               String   @id @default(uuid())
  name             String
  tier             String?
  price            Decimal  @db.Decimal(10, 2)
  validity_days    Int?
  credits_total    Int?
  includes_physique57 Boolean @default(false)
  description      String?
  display_order    Int?
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  user_packages UserPackage[]

  @@map("packages")
}

model UserPackage {
  id                String    @id @default(uuid())
  user_id           String
  package_type_id   String
  package_id        String?
  credits_remaining Int?
  credits_total     Int?
  classes_remaining Int?
  expiration_date   DateTime
  purchase_date     DateTime  @default(now())
  is_active         Boolean   @default(true)
  is_paused         Boolean   @default(false)
  pause_start_date  DateTime?
  pause_end_date    DateTime?
  pass_type         String?
  coupon_id         String?
  purchase_discount_inr Decimal? @db.Decimal(10, 2)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now()) @updatedAt

  profile      Profile     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  package_type PackageType @relation(fields: [package_type_id], references: [id], onDelete: Restrict)
  package      Package?    @relation(fields: [package_id], references: [id], onDelete: SetNull)
  coupon       Coupon?     @relation(fields: [coupon_id], references: [id], onDelete: SetNull)
  bookings     Booking[]
  razorpay_order   RazorpayOrder?
  payments         Payment[]

  @@index([user_id])
  @@index([package_type_id])
  @@index([package_id])
  @@index([coupon_id])
  @@index([expiration_date])
  @@index([is_active, expiration_date])
  @@map("user_packages")
}

model Booking {
  id                String    @id @default(uuid())
  user_id           String
  class_schedule_id String?
  user_package_id   String?
  status            String    @default("confirmed")
  /// Physique 57 instructor sign-off: `pending` until the 57 instructor confirms, then `confirmed`. Null = not a 57 class (no sign-off needed).
  confirmation_status String?
  booking_date      DateTime  @default(now())
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now()) @updatedAt
  cancellation_date DateTime?
  class_name        String?
  class_time        String?
  /// Snapshot of the booked person's email (booker or guest) for quick lookup/audit.
  email             String?
  checked_in        Boolean   @default(false)
  check_in_time     DateTime?
  /// `on_time` | `late` | `no_show` (set by portal check-in or reconcileNoShowsGlobally).
  check_in_outcome  String?
  /// Set when the ~1h pre-class reminder email has been sent (idempotency guard).
  reminder_sent_at    DateTime?
  /// Portal flow may attach friends/family to one roster row (`extra_guest_count` seats).
  extra_guest_count   Int       @default(0)
  /// [{ name, email, phone }] for Finance-1 detail dialog.
  guest_attendees       Json?
  /// Finance-1: class vs café vs tax totals at checkout (see portal book flow).
  finance_snapshot      Json?

  profile        Profile        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  class_schedule ClassSchedule? @relation(fields: [class_schedule_id], references: [id], onDelete: Cascade)
  user_package   UserPackage?   @relation(fields: [user_package_id], references: [id], onDelete: SetNull)
  cafe_orders    CafeOrder[]
  razorpay_order RazorpayOrder?
  payments       Payment[]

  @@index([user_id])
  @@index([class_schedule_id])
  @@index([user_package_id])
  @@index([booking_date])
  @@index([email])
  @@index([status, booking_date])
  @@index([checked_in, booking_date])
  @@index([check_in_outcome, booking_date])
  @@map("class_bookings")
}

/// Razorpay Orders API (`order_*`). Amounts in paise (smallest currency unit) per Razorpay docs / MCP.
model RazorpayOrder {
  id                String   @id @default(uuid())
  user_id           String
  /// Set after class booking row exists — one checkout order links to one booking for portal flow.
  booking_id        String?  @unique
  /// Set after user_packages row exists — package purchase checkout on /portal/packages.
  user_package_id   String?  @unique
  razorpay_order_id String   @unique
  amount_paise      Int
  currency          String   @default("INR")
  receipt           String?
  /// created → paid | failed | expired (approximate lifecycle)
  status            String   @default("created")
  notes             Json?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  profile      Profile           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  booking      Booking?          @relation(fields: [booking_id], references: [id], onDelete: SetNull)
  user_package UserPackage?      @relation(fields: [user_package_id], references: [id], onDelete: SetNull)
  payments     RazorpayPayment[]

  @@index([user_id])
  @@map("razorpay_orders")
}

/// Razorpay Payment (`pay_*`). Gateway-native columns only. Ownership (user, booking, package) lives on `Payment`.
model RazorpayPayment {
  id                   String    @id @default(uuid())
  razorpay_payment_id  String    @unique
  razorpay_order_id    String
  amount_paise         Int?
  currency             String?   @default("INR")
  status               String
  method               String?
  signature_verified   Boolean   @default(false)
  verified_at          DateTime?
  failure_reason       String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  order    RazorpayOrder @relation(fields: [razorpay_order_id], references: [razorpay_order_id], onDelete: Cascade)
  payments Payment[]

  @@index([razorpay_order_id])
  @@map("razorpay_payments")
}

/// Unified payment ledger. Covers offline (cash, Pine Lab card/UPI, direct UPI) and online (Razorpay) — future-proof for new gateways via the `method` enum.
enum PaymentMethod {
  razorpay_online
  razorpay_completed
  pine_lab_card
  pine_lab_upi
  direct_upi
  cash
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

/// Lifecycle for a class schedule row. `available` = bookable. `inactive` = hidden from members (admin draft / paused). `started` / `completed` = lifecycle markers (not booking blockers in member API yet). `cancelled` = soft-deleted; blocks all booking flows.
enum ClassScheduleStatus {
  available
  inactive
  started
  completed
  cancelled
  abandoned
}

model Payment {
  id                  String        @id @default(uuid())
  user_id             String
  user_package_id     String?
  booking_id          String?
  method              PaymentMethod
  status              PaymentStatus @default(succeeded)
  amount_paise        Int
  currency            String        @default("INR")
  /// Free-text reference: txn id, last-4, terminal slip number, etc.
  reference           String?
  /// URL to uploaded proof (receipt/screenshot). Required by policy for offline methods when admin has it.
  proof_url           String?
  notes               String?
  /// Admin profile id who recorded this payment (null for system/online flows).
  recorded_by         String?
  /// Optional FK to razorpay_payments.razorpay_payment_id when this payment was captured via Razorpay (online or completed-via-link).
  razorpay_payment_id String? @unique
  /// Razorpay order id for fulfillment lookup (set on online flows even before razorpay_payment_id is known).
  razorpay_order_id   String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  profile           Profile          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_package      UserPackage?     @relation(fields: [user_package_id], references: [id], onDelete: SetNull)
  booking           Booking?         @relation(fields: [booking_id], references: [id], onDelete: SetNull)
  recorded_by_admin Profile?         @relation("PaymentRecordedBy", fields: [recorded_by], references: [id], onDelete: SetNull)
  razorpay_payment  RazorpayPayment? @relation(fields: [razorpay_payment_id], references: [razorpay_payment_id], onDelete: SetNull)

  @@index([user_id])
  @@index([user_package_id])
  @@index([booking_id])
  @@index([method])
  @@index([status])
  @@index([razorpay_order_id])
  @@map("payments")
}

model CafeItem {
  id           String   @id @default(uuid())
  name         String
  category     String
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  image_url    String?
  image_file_id String? @unique
  is_available Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  cafe_orders CafeOrder[]

  @@map("cafe_items")
}

model CafeOrder {
  id             String   @id @default(uuid())
  user_id        String
  cafe_item_id   String?
  booking_id     String?
  quantity       Int      @default(1)
  payment_method String
  status         String   @default("pending")
  order_date     DateTime @default(now())
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt
  coupon_id      String?
  discount_inr   Decimal  @default(0) @db.Decimal(10, 2)
  batch_id       String?

  profile   Profile   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  cafe_item CafeItem? @relation(fields: [cafe_item_id], references: [id], onDelete: SetNull)
  booking   Booking?  @relation(fields: [booking_id], references: [id], onDelete: SetNull)
  coupon    Coupon?   @relation(fields: [coupon_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([cafe_item_id])
  @@index([booking_id])
  @@index([coupon_id])
  @@index([order_date])
  @@index([batch_id])
  @@map("cafe_orders")
}

model MealSubscription {
  id               String   @id @default(uuid())
  user_id          String
  meal_count       Int      @default(20)
  meals_remaining  Int      @default(20)
  price_per_month  Decimal  @db.Decimal(10, 2)
  start_date       DateTime
  next_billing_date DateTime
  status           String   @default("active")
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  profile Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("meal_subscriptions")
}

/// Public waitlist / contact form submissions from the meal subscription page.
model MealSubscriptionInquiry {
  id         String   @id @default(uuid())
  full_name  String
  email      String
  phone      String
  message    String?
  status     String   @default("new")
  source     String   @default("meal_subscription_waitlist")
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@index([email])
  @@index([created_at])
  @@index([status])
  @@map("meal_subscription_inquiries")
}

/// Space rental inquiry submissions from /rental
model RentalInquiry {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String
  event_type  String?
  event_date  String?
  guest_count String?
  duration    String?
  message     String?
  status      String   @default("new")
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  @@index([email])
  @@index([created_at])
  @@map("rental_inquiries")
}

/// Partial signups captured at step 1 (name + email) before completion — lets us nudge un-converted leads later.
model SignupLead {
  id           String    @id @default(uuid())
  email        String    @unique
  full_name    String
  phone        String?
  status       String    @default("captured") // captured | converted
  converted_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now()) @updatedAt

  @@index([status])
  @@index([created_at])
  @@map("signup_leads")
}

model UserStats {
  id                    String    @id @default(uuid())
  user_id               String    @unique
  total_classes_attended Int      @default(0)
  current_streak        Int       @default(0)
  longest_streak        Int       @default(0)
  last_class_date       DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @default(now()) @updatedAt

  profile Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model UserStreak {
  id                   String    @id @default(uuid())
  user_id              String    @unique
  current_streak       Int       @default(0)
  longest_streak       Int       @default(0)
  last_class_date      DateTime?
  last_attendance_date DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @default(now()) @updatedAt

  profile Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

model BadgeTemplate {
  id                String      @id @default(cuid())
  name              String
  description       String?
  badge_type        String      // "path_to_mastery" | "custom"
  icon              String      @default("🏆")
  color             String      @default("#7C9070")
  threshold_classes Int?        // path_to_mastery only: auto-award at this count
  is_active         Boolean     @default(true)
  sort_order        Int         @default(0)
  created_at        DateTime    @default(now())
  updated_at        DateTime    @default(now()) @updatedAt

  user_badges       UserBadge[]

  @@map("badge_templates")
}

model UserBadge {
  id                String   @id @default(uuid())
  user_id           String
  badge_name        String
  badge_description String?
  milestone_value   Int?
  total_classes     Int?
  earned_at         DateTime @default(now())
  badge_template_id String?
  badge_type        String   @default("path_to_mastery")  // "path_to_mastery" | "custom"
  icon              String?  @default("🏆")
  color             String?  @default("#7C9070")
  allocated_by      String?  // admin user id for custom badges
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now()) @updatedAt

  profile        Profile        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  badge_template BadgeTemplate? @relation(fields: [badge_template_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([badge_template_id])
  @@map("user_badges")
}

model Waiver {
  id           String   @id @default(uuid())
  user_id      String
  waiver_type  String
  signed_date  DateTime @default(now())
  document_url String?
  ip_address   String?
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  profile Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("waivers")
}

model CrmTemplate {
  id                String   @id @default(uuid())
  name              String
  template_key      String?  @unique
  is_system         Boolean  @default(false)
  template_type     String
  subject           String?
  message_body      String
  channel_email     Boolean  @default(false)
  channel_whatsapp  Boolean  @default(false)
  variables         Json     @default("[]")
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now()) @updatedAt

  crm_messages CrmMessage[]
  crm_triggers CrmTrigger[]

  @@map("crm_templates")
}

model CrmMessage {
  id           String    @id @default(uuid())
  user_id      String?
  template_id  String?
  channel      String
  subject      String?
  message_body String
  status       String    @default("pending")
  scheduled_for DateTime?
  sent_at      DateTime?
  error_message String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now()) @updatedAt

  profile  Profile?     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  template CrmTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([template_id])
  @@index([created_at])
  @@map("crm_messages")
}

model CrmTrigger {
  id               String   @id @default(uuid())
  name             String
  template_id      String?
  trigger_type     String
  is_active        Boolean  @default(true)
  channel_email    Boolean  @default(false)
  channel_whatsapp Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  template CrmTemplate? @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@map("crm_triggers")
}

/// Anonymous or authenticated browser sessions for behavioral analytics (group related events).
model UserActivitySession {
  id           String    @id @default(uuid())
  visitor_id   String
  profile_id   String?
  role         String?
  user_agent   String?
  ip           String?
  referrer     String?
  started_at   DateTime  @default(now())
  last_seen_at DateTime  @default(now()) @updatedAt
  ended_at     DateTime?

  profile Profile?            @relation(fields: [profile_id], references: [id], onDelete: SetNull)
  events  UserActivityEvent[]

  @@index([visitor_id])
  @@index([profile_id])
  @@index([started_at])
  @@map("user_activity_sessions")
}

/// Individual user actions / page views / API-backed actions (immutable log).
model UserActivityEvent {
  id                 String   @id @default(uuid())
  session_id         String?
  visitor_id         String
  profile_id         String?
  role_at_time       String?
  event_name         String
  event_category     String   @default("general")
  path               String?
  referrer           String?
  http_method        String?
  entity_type        String?
  entity_id          String?
  metadata           Json?
  duration_ms        Int?
  client_occurred_at DateTime?
  created_at         DateTime @default(now())

  session UserActivitySession? @relation(fields: [session_id], references: [id], onDelete: SetNull)
  profile Profile?            @relation(fields: [profile_id], references: [id], onDelete: SetNull)

  @@index([visitor_id])
  @@index([profile_id])
  @@index([event_name])
  @@index([event_category])
  @@index([created_at])
  @@index([session_id])
  @@map("user_activity_events")
}

model MemberTicket {
  id             String   @id @default(uuid())
  user_id        String
  type           String   @default("pause_subscription")
  reason         String
  attachment_url String?
  status         String   @default("open")
  admin_note     String?
  pause_from     DateTime?
  pause_to       DateTime?
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now()) @updatedAt

  profile Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
  @@map("member_tickets")
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  email      String
  role       String?  // which portal login this token resets; null = legacy member ("user")
  token      String   @unique
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@index([email])
  @@map("password_reset_tokens")
}

/// Generic uploaded-file registry (S3 or local fallback). Referenced by QR codes, etc.
model File {
  id           String   @id @default(uuid())
  bucket       String?
  s3_key       String?
  url          String
  content_type String
  size_bytes   Int?
  /// "qr_code" | "avatar" | "payment_proof" | ...
  purpose      String
  /// Profile id of the uploader (admin/system), if known.
  created_by   String?
  created_at   DateTime @default(now())

  qr_codes QrCode[]

  @@index([purpose])
  @@map("files")
}

/// One stored QR per (schedule, kind). Image lives in S3 via `file`; `token` is the
/// signed HMAC encoded in that image (verified statelessly at scan time).
model QrCode {
  id                String   @id @default(uuid())
  class_schedule_id String
  /// "instructor" | "member"
  kind              String
  token             String
  exp               DateTime
  file_id           String?
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now()) @updatedAt

  class_schedule ClassSchedule @relation(fields: [class_schedule_id], references: [id], onDelete: Cascade)
  file           File?         @relation(fields: [file_id], references: [id], onDelete: SetNull)

  @@unique([class_schedule_id, kind])
  @@index([class_schedule_id])
  @@map("qr_codes")
}
