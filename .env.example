# Copy into `.env.local`. Prisma CLI also reads `.env` (see prisma.config.ts).
#
# --- Docker Postgres (npm run docker:db:up) ---
STUDIO_DATABASE_URL=postgresql://copper:copper_dev@127.0.0.1:5433/copperandcloves?schema=public
DATABASE_URL=postgresql://copper:copper_dev@127.0.0.1:5433/copperandcloves?schema=public
#
# If signup/API still fails with "postgres" auth errors, Windows may have DATABASE_URL in
# System Environment Variables (Next.js will not override it). STUDIO_DATABASE_URL fixes that.

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-secret

# Admin user: npm run db:seed:admin  (optional overrides)
# ADMIN_EMAIL=admin@copperandcloves.local
# ADMIN_PASSWORD=StudioAdmin!2026
#
# One-time live bootstrap (POST /api/setup/bootstrap-admin + header x-admin-setup-secret):
# ADMIN_SETUP_SECRET=long-random-secret

# --- Outbound email (CRM, package receipts, etc.) ---
#
# Option A — Gmail SMTP (used first when both are set). Create an App Password:
#   https://support.google.com/accounts/answer/185833
# Paste EMAIL_PASS with or without spaces. Do not commit real values.
# EMAIL_USER=
# EMAIL_PASS=
#
# Option B — Resend: https://resend.com (fallback if Gmail fails or is unset)
RESEND_API_KEY=
# From address: for Gmail usually same as EMAIL_USER unless you use a Gmail "Send mail as" alias.
EMAIL_FROM=
#
# WhatsApp Cloud API — https://developers.facebook.com/apps/
# Add WhatsApp product; API Setup gives Phone number ID; use temp token or System User permanent token.
# Create an approved MESSAGE TEMPLATE matching WHATSAPP_TEMPLATE_BODY_VARIABLES (default 4 body placeholders).
# @see https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PACKAGE_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_BODY_VARIABLES=4
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# --- Razorpay (India). Test keys start with rzp_test_. Never commit real secrets. ---
# Server: create orders + verify signatures. Client: same Key ID as NEXT_PUBLIC for Checkout script.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=   # must match server key mode (both rzp_test_ or both rzp_live_)
# Test checkout: card 4111 1111 1111 1111 (any expiry/CVV) or UPI success@razorpay
#
# Finance tab sample rows (optional; off in production by default):
# NEXT_PUBLIC_FINANCE_DEMO=1
# Webhook signing secret from Razorpay Dashboard → Developers → Webhooks → your endpoint → Secret.
# (The dashboard settings page URL is not the webhook URL — configure the endpoint URL below.)
# RAZORPAY_WEBHOOK_SECRET=
#
# Production webhook endpoint (HTTPS, same host as the app):
#   https://<your-domain>/api/payments/razorpay/webhook
# Subscribe to at least: payment.authorized, payment.captured, payment.failed
# Local dev: expose with ngrok/cloudflared, e.g. https://abc.ngrok.io/api/payments/razorpay/webhook

# HMAC secret for QR check-in tokens (any long random string)
CHECKIN_QR_SECRET=
