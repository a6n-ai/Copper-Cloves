# Copy into `.env.local`. Prisma CLI also reads `.env` (see prisma.config.ts).
#
# --- Docker Postgres (npm run docker:db:up) ---
STUDIO_DATABASE_URL=postgresql://copper:copper_dev@127.0.0.1:5433/copperandcloves?schema=public
DATABASE_URL=postgresql://copper:copper_dev@127.0.0.1:5433/copperandcloves?schema=public
#
# If signup/API still fails with "postgres" auth errors, Windows may have DATABASE_URL in
# System Environment Variables (Next.js will not override it). STUDIO_DATABASE_URL fixes that.

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-secret

# Admin user: npm run db:seed:admin  (optional overrides)
# ADMIN_EMAIL=admin@copperandcloves.local
# ADMIN_PASSWORD=StudioAdmin!2026
#
# One-time live bootstrap (POST /api/setup/bootstrap-admin + header x-admin-setup-secret):
# ADMIN_SETUP_SECRET=long-random-secret

# --- Package purchase notifications (triggered after POST /api/user-packages) ---
#
# Email: https://resend.com — RESEND_API_KEY + verified EMAIL_FROM domain (or onboarding@resend.dev for testing)
RESEND_API_KEY=
EMAIL_FROM=
#
# WhatsApp Cloud API — https://developers.facebook.com/apps/
# Add WhatsApp product; API Setup gives Phone number ID; use temp token or System User permanent token.
# Create an approved MESSAGE TEMPLATE matching WHATSAPP_TEMPLATE_BODY_VARIABLES (default 4 body placeholders).
# @see https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PACKAGE_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_BODY_VARIABLES=4
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91
