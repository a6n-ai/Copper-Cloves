{
  "name": "softgen-starter",
  "version": "2.4.4",
  "private": true,
  "browserslist": [
    "chrome >= 93",
    "edge >= 93",
    "firefox >= 92",
    "safari >= 15.4",
    "not dead"
  ],
  "scripts": {
    "dev": "docker compose up -d && next dev --turbopack",
    "dev:next": "next dev --turbopack",
    "dev:fresh": "rm -rf .next && next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "echo 'Postinstall: skipping prisma generate (runs during build)'",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "ci:db-push": "node scripts/ci-db-push.mjs",
    "db:studio": "prisma studio",
    "docker:db:up": "docker compose up -d",
    "docker:db:down": "docker compose down",
    "docker:db:push": "node scripts/docker-db-push.mjs",
    "db:seed:admin": "tsx scripts/ensure-admin.ts",
    "db:seed:instructors": "tsx scripts/seed-instructors.ts",
    "db:seed:weekend-may-2026": "tsx scripts/seed-weekend-schedule-may-2026.ts",
    "db:seed:members": "tsx scripts/seed-member-users.ts",
    "db:seed:chef": "tsx scripts/seed-chef.ts",
    "db:seed:crm-system": "tsx scripts/seed-crm-system-templates.ts",
    "db:seed:crm-triggers": "tsx scripts/seed-crm-system-triggers.ts",
    "sync:public": "tsx scripts/sync-public-to-s3.ts",
    "optimize:images": "tsx scripts/optimize-images.ts",
    "optimize:videos": "tsx scripts/optimize-videos.ts",
    "backfill:s3-webp": "tsx scripts/backfill-s3-webp.ts",
    "check:env": "tsx scripts/check-env.ts",
    "crm:dump-templates": "tsx scripts/dump-email-templates.ts",
    "instructor:set-password": "tsx scripts/set-instructor-password.ts",
    "scheduler": "tsx scripts/scheduler.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1049.0",
    "@aws-sdk/s3-request-presigner": "^3.1049.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/formidable": "^3.5.1",
    "@types/pg": "^8.20.0",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.2.1",
    "formidable": "^3.5.4",
    "framer-motion": "^12.39.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.40.0",
    "next": "15.5.16",
    "next-auth": "^4.24.14",
    "nodemailer": "^7.0.13",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "react": "^19.2.6",
    "react-day-picker": "^8.10.2",
    "react-dom": "^19.2.6",
    "react-easy-crop": "^5.5.7",
    "react-hook-form": "^7.76.0",
    "react-phone-number-input": "^3.4.16",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.19.19",
    "@types/nodemailer": "^7.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.18",
    "postcss": "^8",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.2",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
